      makeTranslationChunk({ id: 'a', originalText: 'Hello', currentDraft: 'Ciao', status: 'completed' as const, stageResults: {}, judgeResult: { content: '', status: 'idle' as const, rating: 'fair' as const, issues: [] } }),
