              onRefine={handleRefineCoherencePrompt}
              onChange={(value) => setConfig((prev) => ({ ...prev, coherencePrompt: value }))}
              onApplyTemplate={(template) => {
                setConfig((prev) => ({
                  ...prev,
                  coherencePrompt: template.prompt,
