                title={t('editor.textSmall')}
                ariaLabel={t('editor.textSmall')}
                disabled={textSizeStep === 0}
              >
                <Minus size={15} />
              </ToolbarButton>
              <ToolbarButton
                active={textSizeStep === DEFAULT_TEXT_SIZE_STEP}
